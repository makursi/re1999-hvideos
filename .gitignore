node_modules/
dist/
coverage/
*.log

# local environment overrides (never committed); .env.example stays versioned
.env
.env.*
!.env.example

# generated media (never commit large outputs)
# three-stage layout (ADR-0009): input/ = raw sources, work/ = specs (versioned),
# output/ = products (ignored). Spec files are the only thing under work/ that
# goes to git; the product patterns below are just safety nets for stray files.
media/output/
media/work/**/*.{mp4,jpg,png,webp}
media/temp/

# input: raw media stays local; only per-project README anchors are versioned
media/input/*
!media/input/*/
media/input/*/videos/*
media/input/*/audios/*