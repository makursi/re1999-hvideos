{
  "name": "re1999-hvideos",
  "version": "0.1.0",
  "description": "Clip 1999 Arcane Incident Department raw videos into segments per per-episode manifests; extract frame screenshots per frames specs",
  "private": true,
  "type": "module",
  "scripts": {
    "re1999": "tsx src/main.ts",
    "clip": "tsx src/main.ts clip",
    "snap": "tsx src/main.ts snap",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": "oxlint --fix --deny-warnings"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck && pnpm test"
  }
}