{
  "name": "re1999-hvideos",
  "version": "0.1.0",
  "description": "Clip 1999 Arcane Incident Department raw videos into segments per manifest.json",
  "private": true,
  "type": "module",
  "scripts": {
    "clip": "tsx src/clip.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}