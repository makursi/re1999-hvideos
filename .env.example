# re1999-hvideos environment configuration (ADR-0007)
# All knobs are optional; defaults reproduce the classic media/ layout.
# Copy to `.env` and adjust — `.env` is git-ignored, this file is versioned.
# Precedence: CLI flags > shell environment > .env > defaults.

# Spec scan bases + snap probe workspace (defaults = the media/ layout)
RE1999_EXPORTS_DIR=media/exports
RE1999_SCREENSHOTS_DIR=media/screenshots
RE1999_TEMP_DIR=media/temp

# Tool binaries (widely-used names, kept unprefixed)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# NOT configurable: raw input `source` paths live in the versioned spec JSONs
# (media/raw/...) and stay read-only; domain constants (25 fps, 64-frame shift
# window, solid-frame thresholds) are domain truth, not configuration.