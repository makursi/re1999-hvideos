# re1999-hvideos environment configuration (ADR-0007, revised by ADR-0009)
# All knobs are optional; defaults reproduce the three-stage media/ layout.
# Copy to `.env` and adjust — `.env` is git-ignored, this file is versioned.
# Precedence: CLI flags > shell environment > .env > defaults.

# Spec scan root + product default root + snap probe workspace (ADR-0009)
RE1999_WORK_DIR=media/work
RE1999_OUTPUT_DIR=media/output
RE1999_TEMP_DIR=media/temp

# Tool binaries (widely-used names, kept unprefixed)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# NOT configurable: raw input `source` paths live in the versioned spec JSONs
# (media/input/...) and stay read-only; domain constants (25 fps, 64-frame shift
# window, solid-frame thresholds) are domain truth, not configuration.
